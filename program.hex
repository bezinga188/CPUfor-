# --- 初始化寄存器 ---
0ff00293  # addi x5, x0, 255    # x5 = 0x000000FF (测试数据1)
f0100313  # addi x6, x0, -255   # x6 = 0xFFFFFF01 (测试数据2)
00000393  # addi x7, x0, 0      # x7 = 基地址 0x0

# --- Store 指令测试 (写入 Memory) ---
0053a023  # sw x5, 0(x7)        # [Addr 0] = 0x000000FF (Case 1: 0偏移, 字写入)
00639223  # sh x6, 4(x7)        # [Addr 4] = 0xFF01     (Case 2: 正偏移, 半字写入)
fe638ea3  # sb x6, -3(x7)       # [Addr -3] = 0x01      (Case 3: 负偏移, 字节写入)
0053a423  # sw x5, 8(x7)        # [Addr 8] = 0x000000FF (用于后续跨偏移读取)

# --- Load 指令测试 (从 Memory 读回寄存器) ---
0003a283  # lw  x5, 0(x7)       # x5 = 0x000000FF (验证 SW)
00439303  # lh  x6, 4(x7)       # x6 = 0xFFFFFF01 (验证 SH + 符号扩展: 0xFF01 -> 32位)
0043d383  # lhu x7, 4(x7)       # x7 = 0x0000FF01 (验证 LHU + 无符号扩展)
ffd00403  # lb  x8, -3(x7)      # x8 = 0x00000001 (验证 SB + 字节读取)
00804483  # lbu x9, 8(x7)       # x9 = 0x000000FF (验证 LBU)
00900503  # lb  x10, 9(x7)      # x10 = 0x00000000 (Case 4: 跨字偏移, 读取 0x000000FF 的高位字节)

# --- 结束标志 ---
00100073  # ebreak              # 停止仿真