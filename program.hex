# --- 初始化寄存器 (准备比较数据) ---
00a00293  # addi x5, x0, 10      # x5 = 10
01400313  # addi x6, x0, 20      # x6 = 20
f0100393  # addi x7, x0, -255    # x7 = 0xFFFFFF01 (负数)

# --- 1. 测试 BEQ/BNE (相等/不相等) ---
00628463  # beq x5, x6, 8        # 10 == 20? 失败 -> 执行下一条
00629463  # bne x5, x6, 8        # 10 != 20? 成功 -> 跳过下一条
00100293  # addi x5, x5, 1       # [应该被跳过]

# --- 2. 测试 BLT/BGE (有符号小于/大于等于) ---
0072c463  # blt x5, x7, 8        # 10 < -255? 失败 (10 > -255)
0072d463  # bge x5, x7, 8        # 10 >= -255? 成功 -> 跳转
00100293  # addi x5, x5, 1       # [应该被跳过]

# --- 3. 测试 BLTU/BGEU (无符号比较) ---
0072e463  # bltu x5, x7, 8       # 10 < 0xFFFFFF01? 成功 (无符号下 10 确实更小)
00100293  # addi x5, x5, 1       # [应该被跳过]
0072f463  # bgeu x5, x7, 8       # 10 >= 0xFFFFFF01? 失败

# --- 4. 测试负向跳转 (向后跳) ---
ff000013  # addi x0, x0, 0       # 占位符 (PC=x)
fe028ee3  # beq x5, x5, -4       # 10 == 10? 成功 -> 跳转回上一条指令 (死循环测试)

# --- 结束标志 (如果跳出了死循环说明有问题) ---
00100073  # ebreak