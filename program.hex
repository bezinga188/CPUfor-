# ===============================
# 基础初始化
# ===============================
06400393  # addi x7, x0, 100      # x7 = 100（非零基址）
11200293  # addi x5, x0, 0x112    # x5 = 0x00000112（低字节=0x12）
f8000313  # addi x6, x0, -128     # x6 = 0xFFFFFF80

# ===============================
# Case 1: 端序测试（Little Endian）
# ===============================
0053a023  # sw x5, 0(x7)          
# Memory[100] = 0x12
# Memory[101] = 0x01
# Memory[102] = 0x00
# Memory[103] = 0x00

0003c403  # lbu x8, 0(x7)         # x8 = 0x12
0013c483  # lbu x9, 1(x7)         # x9 = 0x01
0023c503  # lbu x10,2(x7)         # x10 = 0x00
0033c583  # lbu x11,3(x7)         # x11 = 0x00

# ✅ 验证：
# x8  = 0x12
# x9  = 0x01
# x10 = 0x00
# x11 = 0x00

# ===============================
# Case 2: 覆盖写（byte 不污染其他位）
# ===============================
006382a3  # sb x6, 5(x7)          # Memory[105] = 0x80
0053a223  # sw x5, 4(x7)          # Memory[104~107] = 0x00000112

0043a603  # lw x12,4(x7)

# ✅ 预期：
# Memory[104] = 0x12
# Memory[105] = 0x01（被覆盖！不是0x80）
# Memory[106] = 0x00
# Memory[107] = 0x00
# x12 = 0x00000112

# ===============================
# Case 3: 负偏移 + 非零基址
# ===============================
fe638ea3  # sb x6, -3(x7)         # addr = 97 → 写 0x80
ffd3c703  # lbu x14,-3(x7)        # x14 = 0x80

# ✅ 预期：
# x14 = 0x00000080

# ===============================
# Case 4: 符号扩展边界（lb）
# ===============================
ffd38403  # lb x8, -3(x7)         # x8 = 0xFFFFFF80

# ✅ 预期：
# x8 = 0xFFFFFF80（符号扩展）

# ===============================
# Case 5: 非对齐访问（如果你支持）
# ===============================
0023a703  # lw x14,2(x7)          # 非对齐

# ⚠️ 这里分两种情况：
# ✔ 如果你实现异常：
#   → 应该 trap
# ✔ 如果你没实现异常：
#   → 至少不能乱读（通常会错）

# ===============================
# Case 6: Load-Use Hazard（流水线才需要）
# ===============================
0003a283  # lw x5,0(x7)
00530333  # add x6,x6,x5

# ✅ 预期：
# x6 = 原x6 + x5（不能用旧值）

# ===============================
# 结束
# ===============================
00100073  # ebreak